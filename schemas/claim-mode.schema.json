{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/prophet-platform-standards/claim-mode.schema.json",
  "title": "SocioProphet Claim Mode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "mode", "subject", "evidence", "non_claims"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^0\\.[0-9]+$" },
    "claim_id": { "type": "string", "minLength": 4 },
    "subject": { "type": "string", "minLength": 4 },
    "mode": {
      "type": "string",
      "enum": [
        "formal_construction",
        "illustrative_schema",
        "fixture_validated",
        "experimental_run",
        "independently_reproduced",
        "audited_run"
      ]
    },
    "sufficiency_type": {
      "type": "string",
      "enum": [
        "microstate_sufficient",
        "reconstruction_sufficient",
        "semantic_sufficient",
        "task_sufficient",
        "governance_sufficient",
        "audit_sufficient",
        "not_sufficient"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "uri": { "type": "string" },
          "hash": { "type": "string" },
          "verdict": { "type": "string", "enum": ["PROVED", "VIOLATION", "INCONCLUSIVE", "not_applicable"] }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "non_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "policy": { "type": "string" },
        "approved_by": { "type": "string" }
      }
    }
  }
}
